---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
import { getPublicationLabels } from '../lib/publications';

const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.year - a.data.year ||
    a.data.title.localeCompare(b.data.title),
);
const pubLabels = await getPublicationLabels();
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
---

<BaseLayout
  title="Projects"
  description="Research and personal projects by Antonio Lara Gutiérrez: honeypots, GANs, concept drift and malware analysis."
>
  <div class="stack">
    <header class="page-header" data-reveal>
      <span class="eyebrow">Code &amp; prototypes</span>
      <h1>Projects</h1>
      <p>
        Open-source tools and research prototypes: generative honeypots, synthetic traffic for
        intrusion detection, concept-drift adaptation, malware classification and attribution.
      </p>
    </header>

    <ul class="grid" data-reveal-stagger="80">
      {
        rendered.map(({ p, Content }) => (
          <li class="card">
            <div class="top">
              <span class="eyebrow">{p.data.year}</span>
              {p.data.featured && <span class="featured">Featured</span>}
            </div>
            <h2>
              {p.data.repo ? (
                <a href={p.data.repo} target="_blank" rel="noopener">
                  {p.data.title}
                </a>
              ) : (
                p.data.title
              )}
            </h2>
            <p class="summary">{p.data.summary}</p>
            <div class="body soft">
              <Content />
            </div>
            {p.data.tags.length > 0 && (
              <ul class="tags">
                {p.data.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )}
            <div class="links">
              {p.data.repo && (
                <a class="pill" href={p.data.repo} target="_blank" rel="noopener">
                  <Icon name="github" size={12} /> Code
                </a>
              )}
              {p.data.links.map((l) => (
                <a class="pill" href={l.href} target="_blank" rel="noopener">
                  <Icon name="external-link" size={12} /> {l.label}
                </a>
              ))}
              {p.data.publications.map((key) => (
                <a class="pill" href={`${url('/publications')}#${key}`}>
                  <Icon name="file-text" size={12} /> {pubLabels.get(key) ?? 'Paper'}
                </a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .grid { grid-template-columns: 1fr 1fr; }
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.45s var(--ease),
      border-color 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .featured {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8a5a00;
    background-color: var(--highlight);
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
  }
  h2 {
    font-size: 1.35rem;
    line-height: 1.25;
  }
  h2 a { color: var(--accent); }
  h2 a:hover { color: var(--accent-strong); }
  .summary {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--fg);
  }
  .body {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .body :global(p + p) { margin-top: 0.5rem; }
  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
</style>
