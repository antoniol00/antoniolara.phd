---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PublicationList from '../components/PublicationList.astro';
import { site, socials } from '../data/site';
import { researchInterests } from '../data/cv';
import { getActivities, parseDate, shortMonth } from '../lib/activities';
import { getPublications } from '../lib/publications';
import { url } from '../lib/url';
import profile from '../assets/profile.png';

const publications = await getPublications();
const activities = (await getActivities()).slice(0, 4);
const selected = publications.filter((p) => p.data.selected);

---

<BaseLayout title="About">
  <div class="stack">
    <section class="hero">
      <div class="intro" data-reveal-stagger="90">
        <span class="eyebrow">PhD Candidate · AI for Cybersecurity</span>
        <h1>{site.firstName} <strong>{site.lastName}</strong></h1>
        <p class="role">PhD Candidate &amp; FPU Predoctoral Researcher. AI for Cybersecurity</p>
        <p class="affiliation">
          <a href="https://www.nics.uma.es/" target="_blank" rel="noopener">NICS Lab</a>. Dept. of
          Languages and Computer Science. ETSI Informática,{' '}
          <a href="https://www.uma.es/" target="_blank" rel="noopener">University of Málaga</a>
        </p>

        <div class="bio serif">
          <p>
            My research lies at the intersection of <strong>Artificial Intelligence</strong> and <strong>Cybersecurity</strong>.
            I work on <strong>concept-drift</strong> detection and adaptation in AI-driven threat detection
            systems, <strong>multimodal malware</strong> classification and attribution through static,
            dynamic and visual feature fusion, <strong>generative models</strong> (GANs and LLMs) for
            adversarial robustness of intrusion detection and adaptive cyber deception, and <strong>LLM agents</strong>{' '}
            for automated threat intelligence.
          </p>
          <p>
            My goal is to build robust, verifiable and maintainable AI defenses against advanced
            cyber threats.
          </p>
        </div>

        <ul class="interests">
          {researchInterests.map((i) => <li class="tag">{i}</li>)}
        </ul>

        <div class="actions">
          <a class="button" href={url('/cv-antonio-lara-gutierrez.pdf')} download>
            <Icon name="file-down" size={16} /> Download CV
          </a>
          <a class="button ghost" href={url('/publications')}>Publications</a>
          <div class="socials">
            {
              socials.map((s) => (
                <a
                  href={s.href}
                  aria-label={s.label}
                  title={s.label}
                  target={s.name === 'email' ? undefined : '_blank'}
                  rel="noopener noreferrer"
                >
                  <Icon name={s.icon} size={20} />
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <figure class="portrait" data-reveal style="--reveal-delay: 200ms">
        <div class="frame">
          <Image
            src={profile}
            alt={`Portrait of ${site.name}`}
            width={560}
            height={560}
            loading="eager"
          />
        </div>
        <figcaption>
          <span>NICS Lab · ETSI Informática</span>
          <span>University of Málaga, Spain</span>
        </figcaption>
      </figure>
    </section>

    <section>
      <div class="section-head" data-reveal>
        <h2>Activities</h2>
        <a href={url('/activities')}>All activities →</a>
      </div>
      <ul class="activities" data-reveal-stagger="70">
        {
          activities.map((n) => (
            <li>
              <time datetime={n.data.date}>{shortMonth(parseDate(n.data.date))}</time>
              <a class="serif" href={`${url('/activities')}#${n.id}`}>
                {n.data.summary}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      selected.length > 0 && (
        <section>
          <div class="section-head" data-reveal>
            <h2>Selected Publications</h2>
            <a href={url('/publications')}>View all →</a>
          </div>
          <PublicationList items={selected} />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  /* ----- hero ----- */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 820px) {
    .hero {
      grid-template-columns: 1fr 15.5rem;
      gap: 3.5rem;
    }
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: var(--prose-width);
  }
  h1 {
    font-size: 2.9rem;
  }
  @media (min-width: 768px) {
    h1 { font-size: 3.6rem; }
  }
  .role {
    font-size: 1.2rem;
    color: var(--fg);
  }
  .affiliation {
    font-size: 0.95rem;
    color: var(--fg-mute);
  }
  .affiliation a { color: var(--fg-soft); border-bottom: 1px solid var(--border-strong); }
  .affiliation a:hover { color: var(--accent); border-color: var(--accent); }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--fg-soft);
    padding-top: 0.6rem;
    margin-top: 0.4rem;
    border-top: 1px solid var(--border);
  }
  .bio strong { color: var(--fg); font-weight: 700; }
  .interests {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-top: 0.6rem;
  }
  .socials {
    display: flex;
    gap: 0.9rem;
    margin-left: 0.25rem;
  }
  .socials a {
    color: var(--fg-mute);
    transition: color 0.2s var(--ease), transform 0.25s var(--ease);
  }
  .socials a:hover { color: var(--accent); transform: translateY(-2px); }

  .portrait {
    margin: 0 auto;
    width: 15.5rem;
  }
  @media (min-width: 820px) {
    .portrait { margin: 0; }
  }
  .frame {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(18 42 68 / 0.08);
  }
  .frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .frame:hover :global(img) { transform: scale(1.04); }
  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--fg-mute);
  }

  /* ----- activities ----- */
  .activities {
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .activities > li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding: 0.8rem 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
    border-radius: 6px;
    transition: background-color 0.3s var(--ease);
  }
  .activities > li:hover { background-color: var(--bg-tint); }
  .activities time {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-soft);
    padding-top: 0.15rem;
  }
  .activities a { color: var(--fg-soft); }
  .activities a:hover { color: var(--accent); }
</style>
