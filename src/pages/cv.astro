---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Timeline from '../components/Timeline.astro';
import PublicationList from '../components/PublicationList.astro';
import {
  awards,
  education,
  industryExperience,
  languages,
  researchExperience,
  researchProfile,
  skills,
  teaching,
} from '../data/cv';
import { getPublications } from '../lib/publications';
import { url } from '../lib/url';

const publications = await getPublications();
const pdf = url('/cv-antonio-lara-gutierrez.pdf');
---

<BaseLayout title="CV" description="Curriculum Vitae of Antonio Lara Gutiérrez.">
  <div class="stack">
    <header class="page-header split">
      <div class="head">
        <span class="eyebrow">Curriculum Vitae</span>
        <h1>Antonio <strong>Lara Gutiérrez</strong></h1>
        <p>{researchProfile}</p>
        <p class="updated muted">Last updated: September 2026</p>
      </div>
      <div class="downloads">
        <a class="button" href={pdf} download>
          <Icon name="file-down" size={16} /> Download PDF
        </a>
        <a class="button ghost" href={pdf} target="_blank" rel="noopener">View in browser</a>
      </div>
    </header>

    <section>
      <h2 class="section-title" data-reveal>Education</h2>
      <Timeline items={education} />
    </section>

    <section>
      <h2 class="section-title" data-reveal>Research Experience</h2>
      <Timeline items={researchExperience} />
    </section>

    <section>
      <div class="section-head" data-reveal>
        <h2>Publications</h2>
        <a href={url('/publications')}>By category →</a>
      </div>
      <PublicationList items={publications} />
    </section>

    <section>
      <h2 class="section-title" data-reveal>Fellowships, Grants &amp; Awards</h2>
      <Timeline items={awards} />
    </section>

    <section>
      <h2 class="section-title" data-reveal>Teaching &amp; Dissemination</h2>
      <Timeline items={teaching} />
    </section>

    <section>
      <h2 class="section-title" data-reveal>Industry Experience</h2>
      <Timeline items={industryExperience} />
    </section>

    <section>
      <h2 class="section-title" data-reveal>Skills</h2>
      <dl class="skills" data-reveal-stagger="60">
        {
          skills.map((s) => (
            <div>
              <dt class="mono">{s.area}</dt>
              <dd class="serif">{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section>
      <h2 class="section-title" data-reveal>Languages</h2>
      <ul class="languages" data-reveal-stagger="60">
        {
          languages.map((l) => (
            <li>
              <span>{l.name}</span>
              <span class="muted">{l.level}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .head .updated {
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .downloads {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .downloads .button { justify-content: center; }

  .skills > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 0.6rem;
    font-size: 0.95rem;
  }
  @media (min-width: 768px) {
    .skills > div {
      grid-template-columns: 9.5rem 1fr;
      gap: 1.75rem;
    }
    dt { text-align: right; }
  }
  dl, dd { margin: 0; }
  dt {
    font-weight: 600;
    color: var(--accent);
  }
  dd { color: var(--fg-soft); }

  .languages {
    list-style: none;
  }
  .languages > li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding-block: 0.4rem;
    font-size: 0.95rem;
  }
  @media (min-width: 768px) {
    .languages > li {
      grid-template-columns: 9.5rem 1fr;
      gap: 1.75rem;
    }
    .languages > li > span:first-child { text-align: right; }
  }
  .languages > li > span:first-child { font-weight: 600; color: var(--accent); }
  .languages > li > span:last-child { font-family: var(--font-serif); color: var(--fg-soft); }
</style>
