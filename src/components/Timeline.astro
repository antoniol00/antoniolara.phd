---
import { Image } from 'astro:assets';
import type { TimelineEntry } from '../data/cv';

interface Props {
  items: TimelineEntry[];
}

const { items } = Astro.props;
---

<ol class="timeline" data-reveal-stagger="80">
  {
    items.map((e) => (
      <li>
        <div class="period">{e.period}</div>
        <div class:list={['entry', { 'with-logo': e.logo }]}>
          {e.logo && (
            <div class="logo">
              <Image src={e.logo.src} alt={e.logo.alt} width={96} height={96} />
            </div>
          )}
          <div class="head">
            <h3>{e.role}</h3>
            {e.location && <span class="location">{e.location}</span>}
          </div>
          <p class="where serif">{e.where}</p>
          {e.summary && <p class="summary serif">{e.summary}</p>}
          {e.bullets && (
            <ul class="serif">
              {e.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
  }
  @media (min-width: 768px) {
    .timeline > li {
      grid-template-columns: 9.5rem 1fr;
      gap: 1.75rem;
    }
    .period { text-align: right; }
  }
  .period {
    font-size: 0.875rem;
    color: var(--fg-mute);
    padding-top: 0.1rem;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    position: relative;
  }
  @media (min-width: 768px) {
    .entry {
      padding-left: 1.25rem;
      border-left: 2px solid var(--border);
      transition: border-color 0.35s var(--ease);
    }
    li:hover .entry { border-left-color: var(--accent); }
  }
  .with-logo {
    padding-left: 3.6rem;
  }
  @media (min-width: 768px) {
    .with-logo { padding-left: 4.6rem; }
  }
  .logo {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.3rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background-color: var(--logo-bg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  @media (min-width: 768px) {
    .logo { left: 1.25rem; }
  }
  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  li:hover .logo {
    transform: translateY(-2px) scale(1.06);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  h3 {
    font-size: 1.05rem;
    color: var(--fg);
  }
  .location {
    font-size: 0.875rem;
    color: var(--fg-mute);
    white-space: nowrap;
  }
  .where {
    font-style: italic;
    font-size: 0.95rem;
    color: var(--fg-soft);
  }
  .summary,
  ul {
    font-size: 0.925rem;
    color: var(--fg-soft);
    padding-top: 0.25rem;
    line-height: 1.6;
  }
  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  ul li {
    position: relative;
    padding-left: 1.1rem;
  }
  ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    border-left: 6px solid var(--accent-soft);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }
</style>
