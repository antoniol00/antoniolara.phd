---
import Icon from './Icon.astro';
import { site, socials } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="muted">© {year} {site.name}.</p>
    <div class="links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            target={s.name === 'email' ? undefined : '_blank'}
            rel="noopener noreferrer"
          >
            <Icon name={s.icon} />
          </a>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
  }
  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem;
    font-size: 0.875rem;
  }
  @media (min-width: 768px) {
    .inner { flex-direction: row; }
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .links a { color: var(--fg-mute); }
  .links a:hover { color: var(--fg); opacity: 1; }
</style>
