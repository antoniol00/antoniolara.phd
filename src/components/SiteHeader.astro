---
import { nav, site } from '../data/site';
import { url } from '../lib/url';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const target = url(href).replace(/\/$/, '') || '/';
  return current === target;
};
---

<header class="site-header">
  <div class="container bar">
    <a href={url('/')} class="brand">
      {site.firstName} <span class="italic accent">{site.lastName}</span>
    </a>
    <nav aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            class:list={['nav-link', { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--border);
    background-color: rgb(245 240 232 / 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4rem;
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: var(--fg);
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-size: 0.875rem;
  }
  .nav-link {
    color: var(--fg-soft);
  }
  .nav-link:hover {
    color: var(--fg);
    opacity: 1;
  }
  .nav-link.active {
    color: var(--fg);
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .bar {
      padding-block: 0.75rem;
      gap: 0.5rem 1.5rem;
    }
    nav { gap: 1.25rem; }
  }
</style>
