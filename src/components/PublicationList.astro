---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Publication } from '../lib/publications';
import { authorOrcids, orcidUrl } from '../data/authors';

interface Props {
  items: Publication[];
}

const { items } = Astro.props;
const self = 'Lara-Gutiérrez, A.';
---

<ul class="rule-list pubs">
  {
    items.map(({ data: pub }) => (
      <li class="pub" id={pub.key}>
        {pub.cover ? (
          <div class:list={['badge', 'cover', pub.type]}>
            <Image src={pub.cover} alt={`${pub.abbr ?? pub.venue} cover`} width={240} />
          </div>
        ) : (
          <div class="badge mono" aria-hidden="true">
            <span class="key">{pub.key}</span>
            {pub.abbr && <span class="abbr">{pub.abbr}</span>}
          </div>
        )}
        <div class="body">
          <h3>{pub.title}</h3>
          {pub.titleEn && <p class="translation soft">[{pub.titleEn}]</p>}
          <p class="authors soft">
            {pub.authors.map((a, i) => (
              <>
                {authorOrcids[a] ? (
                  <a
                    class:list={['author', { self: a === self }]}
                    href={orcidUrl(authorOrcids[a])}
                    target="_blank"
                    rel="noopener"
                    title={`ORCID ${authorOrcids[a]}`}
                  >
                    {a}
                    <Icon name="orcid" size={11} class="orcid" />
                  </a>
                ) : (
                  <span class:list={{ self: a === self }}>{a}</span>
                )}
                {i < pub.authors.length - 1 && (i === pub.authors.length - 2 ? ' & ' : ', ')}
              </>
            ))}
          </p>
          <p class="venue">
            <em>{pub.venue}</em>
            {pub.details && <span class="muted"> · {pub.details}</span>}
            <span class="muted"> · {pub.year}</span>
          </p>
          <div class="meta">
            {pub.jcr && (
              <span class="pill mono">
                JCR {pub.jcr.quartile} · IF {pub.jcr.impactFactor.toFixed(1)}
              </span>
            )}
            {pub.doi && (
              <a class="pill" href={`https://doi.org/${pub.doi}`} target="_blank" rel="noopener">
                <Icon name="external-link" size={12} /> DOI
              </a>
            )}
            {pub.pdf && (
              <a class="pill" href={pub.pdf} target="_blank" rel="noopener">
                <Icon name="file-text" size={12} /> PDF
              </a>
            )}
            {pub.code && (
              <a class="pill" href={pub.code} target="_blank" rel="noopener">
                <Icon name="github" size={12} /> Code
              </a>
            )}
            {pub.url && (
              <a class="pill" href={pub.url} target="_blank" rel="noopener">
                <Icon name="external-link" size={12} /> Link
              </a>
            )}
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .pub {
    scroll-margin-top: 5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-block: 1.5rem;
  }
  @media (min-width: 768px) {
    .pub { grid-template-columns: 7rem 1fr; }
  }
  .badge {
    display: none;
  }
  @media (min-width: 768px) {
    .badge {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      width: 7rem;
      height: 7rem;
      border: 1px solid var(--border);
      border-radius: 2px;
      background-color: var(--bg-soft);
      text-align: center;
      padding: 0.5rem;
    }
  }
  @media (min-width: 768px) {
    .badge.cover {
      height: auto;
      aspect-ratio: 3 / 4;
      padding: 0;
      overflow: hidden;
      border-radius: 2px;
      box-shadow: 0 1px 2px rgb(26 22 19 / 0.08);
    }
    .badge.cover :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
    }
    .badge.cover.conference {
      background-color: var(--bg-tint);
      padding: 0.6rem;
    }
    .badge.cover.conference :global(img) {
      object-fit: contain;
      object-position: center;
    }
  }
  .key {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
    font-style: italic;
  }
  .abbr {
    font-size: 0.7rem;
    color: var(--fg-mute);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  h3 {
    font-size: 1.3rem;
    line-height: 1.35;
  }
  .translation {
    font-size: 0.875rem;
    font-style: italic;
  }
  .authors {
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .author {
    color: inherit;
    white-space: nowrap;
  }
  .author:hover {
    color: var(--accent);
    opacity: 1;
  }
  .author :global(.orcid) {
    display: inline-block;
    margin-left: 0.2rem;
    vertical-align: -1px;
    color: #a6ce39;
  }
  .self {
    color: var(--fg);
    font-weight: 600;
  }
  .venue {
    font-size: 0.875rem;
  }
  .venue em { color: var(--fg-soft); }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
</style>
